<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CloneHelper" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pcph_accent</item>
        <item name="colorPrimaryVariant">@color/pcph_accent_pressed</item>
        <item name="colorOnPrimary">@color/pcph_text_on_accent</item>
        <item name="colorSecondary">@color/pcph_accent</item>
        <item name="colorOnSecondary">@color/pcph_text_on_accent</item>
        <item name="colorSurface">@color/pcph_surface</item>
        <item name="colorOnSurface">@color/pcph_text_primary</item>
        <item name="android:colorAccent">@color/pcph_accent</item>
        <item name="android:windowBackground">@color/pcph_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlHighlight">@color/pcph_ripple</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.CloneHelper.Dialog</item>
        <item name="snackbarStyle">@style/Widget.CloneHelper.Snackbar</item>
    </style>

    <style name="TextAppearance.CloneHelper.Toolbar" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pcph_text_on_dark</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pcph_accent</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.Primary" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/pcph_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.Secondary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/pcph_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/pcph_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pcph_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.CloneHelper.Diagnostic" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pcph_text_primary</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="TextAppearance.CloneHelper.Button" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pcph_accent</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="ShapeAppearance.CloneHelper.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">2dp</item>
    </style>
    <style name="ThemeOverlay.CloneHelper.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/pcph_accent</item>
        <item name="colorSecondary">@color/pcph_accent</item>
        <item name="colorSurface">@color/pcph_surface</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CloneHelper.Small</item>
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.CloneHelper.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.CloneHelper.DialogBody</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.CloneHelper.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.CloneHelper.DialogButton</item>
    </style>
    <style name="TextAppearance.CloneHelper.DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pcph_text_primary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.CloneHelper.DialogBody" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/pcph_text_secondary</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.CloneHelper.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:minHeight">@dimen/pcph_touch_target</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/pcph_accent</item>
    </style>
    <style name="Widget.CloneHelper.Snackbar" parent="Widget.MaterialComponents.Snackbar">
        <item name="shapeAppearance">@style/ShapeAppearance.CloneHelper.Small</item>
        <item name="backgroundTint">@color/pcph_snackbar_background</item>
    </style>
    <style name="ThemeOverlay.CloneHelper.Popup" parent="ThemeOverlay.MaterialComponents">
        <item name="listPreferredItemHeightSmall">@dimen/pcph_touch_target</item>
        <item name="listPreferredItemPaddingLeft">@dimen/pcph_page_horizontal</item>
        <item name="listPreferredItemPaddingRight">@dimen/pcph_page_horizontal</item>
        <item name="android:colorBackground">@color/pcph_surface</item>
        <item name="android:textColorPrimary">@color/pcph_text_primary</item>
        <item name="android:textColorSecondary">@color/pcph_text_secondary</item>
    </style>
    <style name="TextAppearance.CloneHelper.Time" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/pcph_text_secondary</item>
        <item name="android:fontFamily">monospace</item>
    </style>
    <style name="TextAppearance.CloneHelper.DetailTitle" parent="TextAppearance.CloneHelper.Primary">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="TextAppearance.CloneHelper.RawLabel" parent="TextAppearance.CloneHelper.Secondary">
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>

