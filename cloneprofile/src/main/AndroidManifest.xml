<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<queries>
		<intent><action android:name="android.settings.MANAGE_CLONED_APPS_SETTINGS" /></intent>
		<intent><action android:name="android.settings.APPLICATION_SETTINGS" /></intent>
	</queries>
	<application android:name=".HelperApplication" android:allowBackup="false"
		android:label="@string/app_name" android:supportsRtl="true" android:theme="@style/Theme.CloneHelper">
		<activity android:name=".MainActivity" android:exported="true">
			<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
		</activity>
		<service android:name=".HookReportService" android:exported="true"
			android:description="@string/report_service_description"/>
	</application>
</manifest>
